<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal, hand-written native ad template. Deliberately not a Google
  "nativetemplates" sample layout — this project does not read or copy any
  third-party native-ad wiring (see ADMOB-CLEANROOM-SPEC.md §2).

  Rendered by NativeAdService.java: every id below is looked up with
  findViewById() and registered with the corresponding
  NativeAdView.set*View() call, then the asset content is populated from the
  loaded NativeAd. The "Ad" attribution badge is built by hand (Google does
  not auto-generate it); the AdChoices overlay is added automatically by the
  SDK on top of this view and must not be repositioned here.
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/admob_native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFFFF"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/admob_native_ad_attribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ad"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:background="#FFFFA500"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/admob_native_ad_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/admob_native_ad_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FF000000"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/admob_native_ad_media"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/admob_native_ad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:textColor="#FF444444"
            android:maxLines="2"
            android:ellipsize="end" />

        <Button
            android:id="@+id/admob_native_ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
